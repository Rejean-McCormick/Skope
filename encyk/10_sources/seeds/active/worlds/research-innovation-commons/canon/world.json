{
  "schema_version": "kx-world-canon/v1",
  "world_key": "research-innovation-commons",
  "title": "NEXUS Research Commons",
  "subtitle": "Five Countries, One Disease, No Shared Scientific Language",
  "language": "en",
  "fictional": true,
  "safety_note": "NEX-27, all institutions, people, datasets and findings in this World are fictional and are not medical guidance or real-world scientific claims.",
  "promise": "Maintain continuity from research question to evidence, expertise, execution, result, interpretation and the next question.",
  "acts": [
    {
      "key": "ACT-I",
      "title": "We Don't Mean the Same Thing",
      "goal": "Expose definition and method mismatch before interpreting disagreement."
    },
    {
      "key": "ACT-II",
      "title": "The Experiment That Failed",
      "goal": "Treat negative and null results as reusable first-class knowledge."
    },
    {
      "key": "ACT-III",
      "title": "What Do We Do Next?",
      "goal": "Allocate scarce research resources without confusing collective choice with scientific truth."
    },
    {
      "key": "EPILOGUE",
      "title": "Promising ≠ Proven",
      "goal": "Communicate a preliminary result without severing provenance, uncertainty or limitations."
    }
  ],
  "invariants": [
    "Evidence outranks popularity.",
    "Expertise informs interpretation; it does not establish truth.",
    "Raw readings remain visible beside weighted readings.",
    "Negative and null results are first-class knowledge.",
    "Every important claim can trace to evidence and provenance.",
    "Every important result can trace to protocol, data and version.",
    "Uncertainty must remain representable.",
    "Derived summaries never overwrite canonical source material.",
    "Scientific disagreement is preserved rather than prematurely collapsed.",
    "Decisions and scientific findings are different object classes."
  ],
