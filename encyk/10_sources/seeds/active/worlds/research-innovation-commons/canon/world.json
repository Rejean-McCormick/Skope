  "definitions": [
    {
      "key": "DEF-001",
      "term": "case",
      "canonical_definition": "A participant meeting the harmonized NEX-27 inclusion rule defined in PROT-001 v3.",
      "status": "harmonized",
      "origin": "Act I"
    },
    {
      "key": "DEF-002",
      "term": "recovery",
      "canonical_definition": "Sustained return below the agreed symptom-impact threshold for at least two consecutive observations.",
      "status": "harmonized",
      "origin": "Act I"
    },
    {
      "key": "DEF-003",
      "term": "response",
      "canonical_definition": "A prespecified change on the consortium response composite; not synonymous with recovery.",
      "status": "harmonized",
      "origin": "Act I"
    },
    {
      "key": "DEF-004",
      "term": "significant",
      "canonical_definition": "Must specify whether statistical, clinical or operational significance is intended.",
      "status": "harmonized",
      "origin": "Act I"
    },
    {
      "key": "DEF-005",
      "term": "confirmed",
      "canonical_definition": "Observed with the agreed method and independently reproduced or supported by a preregistered confirmatory analysis.",
      "status": "contested",
      "origin": "Act I"
    },
    {
      "key": "DEF-006",
      "term": "relapse",
      "canonical_definition": "Return above the symptom-impact threshold after a period meeting DEF-002.",
      "status": "harmonized",
      "origin": "Act I"
    }
  ],
