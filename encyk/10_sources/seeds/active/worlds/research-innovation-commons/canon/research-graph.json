{
  "schema_version": "kx-world-research-graph/v1",
  "world_key": "research-innovation-commons",
  "graph_contract": "question → hypothesis/claim → evidence → result → experiment → protocol+dataset → project, with result feedback into hypotheses and current knowledge",
  "relation_semantics": {
    "has_hypothesis": "research question proposes a testable hypothesis",
    "has_claim": "research question contains a current scientific claim",
    "supported_or_challenged_by": "claim cites a canonical evidence item",
    "derived_from": "evidence is a reading of a canonical result",
    "produced_by": "evidence/result was produced by an experiment",
    "uses_protocol": "experiment names the exact protocol version",
    "uses_dataset": "experiment names the exact dataset version",
    "contains_experiment": "project owns execution context",
    "supports": "result increases support for a hypothesis",
    "weakens": "result reduces support without global falsification",
    "contradicts": "result contradicts the tested prediction under declared conditions"
  },
