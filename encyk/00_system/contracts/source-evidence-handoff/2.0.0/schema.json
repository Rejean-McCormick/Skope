{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://encyk.local/contracts/source-evidence-handoff/2.0.0/schema.json",
  "title": "EncyK Source Evidence Handoff 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "producer",
    "consumer",
    "scope_key",
    "snapshot_id",
    "source_system",
    "source_descriptor",
    "source_snapshot",
    "created_at",
    "files",
    "invariants",
    "handoff_id"
  ],
  "properties": {
    "schema_version": {
      "const": "encyk-source-evidence-handoff/v2"
    },
    "contract": {
      "const": "encyk.source-evidence-handoff/2.0.0"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "version"
      ],
      "properties": {
        "system": {
          "const": "encyk"
        },
        "version": {
          "enum": [
            "0.12.0",
            "0.13.0",
            "0.13.1",
            "0.13.3",
            "0.13.4",
            "0.13.5",
            "0.13.6",
            "0.13.7",
            "0.13.8",
            "0.13.11",
            "0.13.12",
            "0.13.13",
            "0.13.14",
            "0.13.15",
            "0.13.16",
            "0.13.17",
            "0.14.0"
          ]
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "minimum_version",
        "source_catalog_profile"
      ],
      "properties": {
        "system": {
          "const": "koa-mediatheque"
        },
        "minimum_version": {
          "const": "0.2.0"
        },
        "source_catalog_profile": {
          "const": "koa.source-catalog/2.0.0"
        }
      }
    },
    "scope_key": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_snapshot": {
      "type": "object",
      "minProperties": 1
    },
    "scope_config": {
      "$ref": "#/$defs/fileEntry"
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^handoff-[0-9a-f]{20}$"
    },
    "source_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_source_id",
        "title",
        "source_kind",
        "source_family",
        "canonical_url"
      ],
      "properties": {
        "external_source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
